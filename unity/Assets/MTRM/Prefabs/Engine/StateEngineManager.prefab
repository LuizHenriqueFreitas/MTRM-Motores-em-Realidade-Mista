  m_EditorClassIdentifier: 
  id: 303
  instanceIndex: 1
  subIndex: 1
  representation: 1
  displayName: "V\xE1lvula de Admiss\xE3o"
  educationalDescription: "A v\xE1lvula \xE9 formada pela haste e pelo tampo. O ressalto
    da \xE1rvore de cames a empurra, o tampo se afasta da sede e a passagem se abre;
    a mola devolve a v\xE1lvula \xE0 posi\xE7\xE3o fechada. Em motores DOHC reais
    existe um tucho ou balancim entre o came e a v\xE1lvula, pe\xE7a que este modelo
    n\xE3o representa."
  intentionallyUnidentified: 0
  justification: 
