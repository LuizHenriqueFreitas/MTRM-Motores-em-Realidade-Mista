  m_Script: {fileID: 11500000, guid: a0f6c3ed58474ad99ecf0bd5b7f38e11, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  id: 104
  instanceIndex: 0
  subIndex: 0
  representation: 1
  displayName: "Junta do Cabe\xE7ote"
  educationalDescription: "Esta junta funciona como um selo. \xC9 normalmente uma
    chapa met\xE1lica que fica entre o bloco do motor e o cabe\xE7ote, e \xE9 importante
    justamente para manter o funcionamento adequado, fazendo a jun\xE7\xE3o entre
    os dois componentes principais e aguentando a press\xE3o das combust\xF5es. Uma
    junta trincada significa um motor despressurizado, que provavelmente ter\xE1
    vazamento de arrefecimento para dentro dos sistemas internos e problemas de sincronia."
  intentionallyUnidentified: 0
  justification: 
