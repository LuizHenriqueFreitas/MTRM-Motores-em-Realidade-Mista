  m_EditorClassIdentifier: 
  id: 307
  instanceIndex: 1
  subIndex: 2
  representation: 2
  displayName: Prato da Mola
  educationalDescription: "O prato de mola prende a extremidade superior da mola
    \xE0 haste da v\xE1lvula. \xC9 por meio dele que a for\xE7a da mola chega \xE0
    v\xE1lvula e a devolve \xE0 posi\xE7\xE3o fechada. Por isso ele se desloca junto
    com a v\xE1lvula, e n\xE3o fica parado como as pe\xE7as fixas do cabe\xE7ote."
  intentionallyUnidentified: 0
  justification: 
