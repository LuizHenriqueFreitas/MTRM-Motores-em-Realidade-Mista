  subIndex: 0
  representation: 1
  displayName: Tampa do Motor
  educationalDescription: "A tampa superior do motor \xE9 a prote\xE7\xE3o do cabe\xE7ote
    em rela\xE7\xE3o ao meio externo. Al\xE9m disso, apresenta a entrada para colocar
    \xF3leo novo no motor, que descer\xE1 pelas galerias at\xE9 o c\xE1rter."
  intentionallyUnidentified: 0
  justification: 
