  titleText: Base da Valvula
  descriptionText: "Este componete junta a haste e o tampo da valvula que adentra
    a c\xE2mara de combust\xE3o"
--- !u!114 &1532751000888048046
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4570126116707522077}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a0f6c3ed58474ad99ecf0bd5b7f38e11, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  id: 303
  instanceIndex: 1
  subIndex: 1
  representation: 2
  displayName: "V\xE1lvula de Admiss\xE3o"
  educationalDescription: "A v\xE1lvula \xE9 formada pela haste e pelo tampo. O ressalto
    da \xE1rvore de cames a empurra, o tampo se afasta da sede e a passagem se abre;
    a mola devolve a v\xE1lvula \xE0 posi\xE7\xE3o fechada. Em motores DOHC reais
    existe um tucho ou balancim entre o came e a v\xE1lvula, pe\xE7a que este modelo
    n\xE3o representa."
  intentionallyUnidentified: 0
  justification: 
